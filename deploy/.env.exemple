# Domaine public du serveur (le DNS doit pointer vers cette machine, ports 80 et 443 ouverts).
COINCHE_DOMAINE=coinche.example.com

# Image à déployer (publiée par la CI sur GHCR) et nombre d'instances.
COINCHE_IMAGE=ghcr.io/felix-marchenay/coinchenet-core:master
COINCHE_INSTANCES=2

# Mot de passe Postgres : générer avec `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Client web : adresse de retour après connexion et origines autorisées (CORS / WebSocket).
# Par défaut, le client est servi sur le même domaine que l'API.
COINCHE_URL_FRONT=
COINCHE_ORIGINES=
# À renseigner si le client est sur un sous-domaine voisin (ex. .example.com).
COINCHE_COOKIE_DOMAINE=
# Dossier contenant le build du client web (ex. le dist/ du client), servi par Caddy.
# Chemin absolu ou relatif à ce dossier ; par défaut ./web.
COINCHE_WEB=

# Fournisseurs d'identité ; URL de retour à déclarer chez chacun :
#   https://<COINCHE_DOMAINE>/auth/google/retour
#   https://<COINCHE_DOMAINE>/auth/discord/retour
COINCHE_GOOGLE_CLIENT_ID=
COINCHE_GOOGLE_CLIENT_SECRET=
COINCHE_DISCORD_CLIENT_ID=
COINCHE_DISCORD_CLIENT_SECRET=

COINCHE_LOG_NIVEAU=info
